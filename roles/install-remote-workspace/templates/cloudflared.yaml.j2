---
# cloudflared — outbound-only tunnel to Cloudflare's edge (443). No inbound ports
# on your homelab. From the corporate Mac you just open https://<hostname> and
# Zscaler sees normal HTTPS to Cloudflare.
#
# Routing is configured in the Cloudflare Zero Trust dashboard (remotely-managed
# tunnel). Point your public hostnames at the in-cluster service:
#   claude.<your-domain>  → http://remote-workspace.{{ remote_workspace_namespace }}:{{ remote_workspace_code_port }}
#   files.<your-domain>   → http://remote-workspace.{{ remote_workspace_namespace }}:{{ remote_workspace_webdav_port }}
# Protect both with Cloudflare Access (email OTP / Google OAuth / mTLS).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: {{ remote_workspace_namespace }}
  labels:
    app: cloudflared
spec:
  replicas: {{ remote_workspace_cloudflared_replicas }}
  selector:
    matchLabels:
      app: cloudflared
  template:
    metadata:
      labels:
        app: cloudflared
    spec:
      containers:
        - name: cloudflared
          image: {{ remote_workspace_cloudflared_image }}:{{ remote_workspace_cloudflared_tag }}
          args:
            - "tunnel"
            - "--no-autoupdate"
            - "--metrics=0.0.0.0:2000"
            - "run"
          env:
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: remote-workspace
                  key: cloudflared-token
          ports:
            - containerPort: 2000
              name: metrics
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "500m"
              memory: "256Mi"
          livenessProbe:
            httpGet:
              path: /ready
              port: 2000
            failureThreshold: 3
            periodSeconds: 30
