# Copy this file to secrets.yml and fill in your real values.
# secrets.yml is gitignored — NEVER commit tokens to the repo.
# Usage:
#   cp roles/install-csi-rclone/defaults/secrets.yml.example roles/install-csi-rclone/defaults/secrets.yml

csi_rclone_webdav_url: "https://nextcloud.example.com/public.php/webdav/"
csi_rclone_webdav_user: "YOUR_SHARE_TOKEN_HERE"
