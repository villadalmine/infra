# leloir-honcho-mcp — adaptador Honcho REST→MCP (spec-native-memory §Adapter).
# Corre desde la MISMA imagen del control plane (command override), como el
# memory-mcp. Da memoria episódica (Honcho) a agentes black-box por la fachada MCP.
# El gateway lo registra como un MCPServer (transport: mcp) por-tenant.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: leloir-honcho-mcp
  namespace: "{{ leloir_namespace }}"
  labels: {app: leloir-honcho-mcp}
spec:
  replicas: 1
  selector: {matchLabels: {app: leloir-honcho-mcp}}
  template:
    metadata: {labels: {app: leloir-honcho-mcp}}
    spec:
      containers:
        - name: honcho-mcp
          image: "{{ leloir_image }}"
          command: ["/leloir-honcho-mcp"]
          env:
            - {name: HONCHO_BASE_URL, value: "http://honcho-api.honcho.svc.cluster.local:8000"}
            - {name: LELOIR_HONCHO_ADDR, value: ":8090"}
            # El MISMO AUTH_JWT_SECRET con el que Honcho firma (para mint del admin JWT).
            - name: HONCHO_JWT_SECRET
              valueFrom:
                secretKeyRef: {name: honcho-secrets, key: AUTH_JWT_SECRET}
          ports: [{containerPort: 8090, name: http}]
          readinessProbe:
            httpGet: {path: /healthz, port: 8090}
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: leloir-honcho-mcp
  namespace: "{{ leloir_namespace }}"
spec:
  selector: {app: leloir-honcho-mcp}
  ports: [{name: http, port: 8090, targetPort: 8090}]
# NOTA: el Secret honcho-secrets vive en ns honcho → para el secretKeyRef cross-ns,
# el rol debe copiar AUTH_JWT_SECRET a un Secret en ns leloir antes de aplicar esto
# (o mover honcho-mcp al ns honcho). Wiring del gateway: agregar a servers[] del
# tenant que quiera memoria Honcho:  {name: honcho, tenant: <t>, transport: mcp,
# endpoint: http://leloir-honcho-mcp.leloir.svc.cluster.local:8090/}
