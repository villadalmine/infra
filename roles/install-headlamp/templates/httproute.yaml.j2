apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: headlamp
  namespace: {{ headlamp_namespace }}
  labels:
    app.kubernetes.io/name: headlamp
spec:
  parentRefs:
    - name: cluster-gateway
      namespace: gateway
  hostnames:
    - "headlamp.cluster.home"
  rules:
    - backendRefs:
        - name: headlamp
          port: {{ headlamp_service_port }}
