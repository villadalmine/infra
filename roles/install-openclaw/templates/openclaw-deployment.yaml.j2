# Upstream reference: github.com/openclaw/openclaw/scripts/k8s/manifests/deployment.yaml
# Additions vs upstream: nodeSelector, tolerations, smb PVC, LiteLLM env, healthz probes
# To sync with upstream changes: diff against scripts/k8s/manifests/deployment.yaml in the
# openclaw release matching {{ openclaw_version }}.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openclaw
  namespace: {{ openclaw_namespace }}
  labels:
    app: openclaw
    rbac-level: {{ openclaw_rbac_level }}
    llm-backend: {{ openclaw_llm_backend }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: openclaw
  template:
    metadata:
      labels:
        app: openclaw
      annotations:
        openclaw-config/checksum: "{{ openclaw_model_primary | hash('sha1') }}-{{ openclaw_telegram_enabled | string | hash('sha1') }}-{{ openclaw_agent_instructions | hash('sha1') }}"
    spec:
      serviceAccountName: openclaw
      # Cluster-specific: schedule on high-RAM RK1 node
      nodeSelector:
        kubernetes.io/hostname: {{ openclaw_node_hostname }}
      # Required: project-wide toleration for transient NoExecute taints
      tolerations:
        - operator: Exists
      # kubernetes-mcp sidecar shares the pod network namespace so OpenClaw
      # can reach it at http://127.0.0.1:8080/mcp without any Service.
      # Pattern mirrors hermes-agent-mcp (roles/install-hermes-agent).
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        fsGroup: 1000
      # Init container: ensure PVC-backed workspace has the canonical config file
      # Copy operator/ConfigMap config into the writable PVC so the gateway finds
      # a complete openclaw.json (some existing PVs contain a stale partial file).
      initContainers:
        - name: init-plugins
          image: {{ openclaw_image }}:{{ openclaw_version }}
          imagePullPolicy: Always
          command:
            - sh
            - -c
            - |
              if [ -d /home/node/.openclaw/npm ]; then
                echo "Copying plugins from image to emptyDir..."
                # we copy contents because we are mounting the emptyDir directly over npm
                cp -a /home/node/.openclaw/npm/. /mnt/npm-local/ || true
                chown -R 1000:1000 /mnt/npm-local || true
                chmod -R go-w /mnt/npm-local || true
              fi
          volumeMounts:
            - name: npm-local
              mountPath: /mnt/npm-local
        - name: init-config
          image: busybox:1.36
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -eux
              # Ensure destination dir exists
              mkdir -p /home/node/.openclaw
              # Honcho peer map persistence (montado como /home/node/.honcho via subPath)
              mkdir -p /home/node/.openclaw/.honcho-state
              chown 1000:1000 /home/node/.openclaw/.honcho-state || true
              # Replace any stale config on the PVC with the authoritative one from the ConfigMap
              if [ -f /etc/openclaw/openclaw.json ]; then
                cp /etc/openclaw/openclaw.json /home/node/.openclaw/openclaw.json
                chown 1000:1000 /home/node/.openclaw/openclaw.json || true
              fi
              # Clear stale .processing locks from previous pod (PID 1 reuse in containers
              # prevents OpenClaw from detecting stale locks by PID check — rename to unblock queue)
              find /home/node/.openclaw/telegram -name '*.processing' -type f 2>/dev/null | while read f; do
                mv "$f" "${f%.processing}" && echo "Released stale spool lock: $f"
              done || true
          volumeMounts:
            - name: openclaw-data
              mountPath: /home/node/.openclaw
            - name: openclaw-config-json
              mountPath: /etc/openclaw
            - name: tmp
              mountPath: /tmp
      containers:
        - name: openclaw-gateway
          image: {{ openclaw_image }}:{{ openclaw_version }}
          imagePullPolicy: Always
          command:
            - sh
            - -c
            - |
              # Secure the agents directory (2026-06-09: ahora persiste en el PVC
              # openclaw-data — antes era emptyDir y las sesiones se perdían en cada restart)
              mkdir -p /home/node/.openclaw/agents/main/agent || true
              chmod 700 /home/node/.openclaw/agents/main/agent || true
              # Patch MCP SDK default request timeout: 60s → 600s.
              # The @modelcontextprotocol/sdk hardcodes DEFAULT_REQUEST_TIMEOUT_MSEC=60000.
              # openclaw's callTool() does not pass a custom timeout, so all tool calls
              # use this default. ask_hermes_agent needs >60s for Hermes to reason.
              # 2026-06-09: 300s → 600s para igualar mcp.servers.hermes.timeout=600 en
              # openclaw.json (Hermes con LLM free puede tardar >300s en debates largos).
              MCP_PROTO="/app/node_modules/@modelcontextprotocol/sdk/dist/esm/shared/protocol.js"
              if [ -f "$MCP_PROTO" ]; then
                sed -i 's/DEFAULT_REQUEST_TIMEOUT_MSEC = 60000/DEFAULT_REQUEST_TIMEOUT_MSEC = 600000/' "$MCP_PROTO" || true
              fi
              # Create symlinks for plugin-skills (required for internal discovery)
              PLUGIN_DIR="/home/node/.openclaw/plugin-skills"
              mkdir -p $PLUGIN_DIR
              for p in /opt/openclaw/plugins/*; do
                [ -e "$p" ] || continue
                base=$(basename $p)
                ln -sfn $p $PLUGIN_DIR/$base || true
              done
              exec node dist/index.js gateway --port "{{ openclaw_gateway_port }}"
          env:
            - name: NODE_OPTIONS
              value: "--dns-result-order=ipv4first --max-old-space-size=4096"
            - name: HOME
              value: /home/node
            - name: OPENCLAW_CONFIG_DIR
              value: /etc/openclaw
            - name: OPENCLAW_WORKSPACE_DIR
              value: /home/node/.openclaw/workspace
            - name: HONCHO_WORKSPACE
              value: "{{ openclaw_honcho_workspace }}"
            - name: HONCHO_API_KEY
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: HONCHO_API_KEY
            - name: OPENCLAW_GATEWAY_TOKEN
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: OPENCLAW_GATEWAY_TOKEN
            - name: TELEGRAM_BOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: TELEGRAM_BOT_TOKEN
                  optional: true
            - name: TELEGRAM_ALLOWED_USERS
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: TELEGRAM_ALLOWED_USERS
                  optional: true
{% if openclaw_llm_backend == 'litellm' %}
            # Route all LLM traffic through shared in-cluster proxy for Grafana visibility
            - name: OPENAI_API_BASE
              value: "{{ openclaw_litellm_url }}/v1"
            - name: OPENAI_API_KEY
              value: "{{ openclaw_litellm_master_key }}"
{% else %}
            - name: OPENROUTER_API_KEY
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: OPENROUTER_API_KEY
{% endif %}
          ports:
            - name: gateway
              containerPort: {{ openclaw_gateway_port }}
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /healthz
              port: {{ openclaw_gateway_port }}
            initialDelaySeconds: 60
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /readyz
              port: {{ openclaw_gateway_port }}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          resources:
            requests:
              cpu: {{ openclaw_cpu_request }}
              memory: {{ openclaw_memory_request }}
            limits:
              cpu: {{ openclaw_cpu_limit }}
              memory: {{ openclaw_memory_limit }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: openclaw-data
              mountPath: /home/node/.openclaw
            # Peer map del plugin openclaw-honcho (openclaw-peers.json) — sin esto
            # se pierde el mapeo usuario→memoria en cada restart (memoria "amnésica")
            - name: openclaw-data
              mountPath: /home/node/.honcho
              subPath: .honcho-state
            - name: npm-local
              mountPath: /home/node/.openclaw/npm
            - name: openclaw-config-json
              mountPath: /etc/openclaw/openclaw.json
              subPath: openclaw.json
            - name: openclaw-agents-md
              mountPath: /etc/openclaw/AGENTS.md
              subPath: AGENTS.md
            - name: tmp
              mountPath: /tmp
        # ── kubernetes-mcp sidecar ────────────────────────────────────────────
        # Exposes Kubernetes MCP at http://127.0.0.1:8080/mcp (localhost only).
        # Uses the pod's ServiceAccount token — no extra credentials needed.
        - name: kubernetes-mcp
          image: {{ openclaw_mcp_k8s_image | default('registry.registry:5000/ai/kubernetes-mcp-server') }}:{{ openclaw_mcp_k8s_tag | default('v0.0.60') }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -e
              mkdir -p /tmp/.kube
              CA=$(base64 /var/run/secrets/kubernetes.io/serviceaccount/ca.crt | tr -d '\n')
              TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
              cat > /tmp/.kube/config <<EOF
              apiVersion: v1
              kind: Config
              clusters:
              - cluster:
                  certificate-authority-data: ${CA}
                  server: https://kubernetes.default.svc
                name: cluster
              contexts:
              - context:
                  cluster: cluster
                  user: default
                name: default
              current-context: default
              users:
              - name: default
                user:
                  token: ${TOKEN}
              EOF
              export KUBECONFIG=/tmp/.kube/config
              exec /usr/local/bin/kubernetes-mcp-server --port 8080
          env:
            - name: HOME
              value: /tmp
          ports:
            - name: mcp
              containerPort: 8080
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 256Mi
        # ── Smee Webhook Relay ────────────────────────────────────────────────
        # Listens on smee.io SSE stream, formats build notifications,
        # and forwards them natively using the openclaw CLI message send command.
        - name: smee-client
          image: {{ openclaw_image }}:{{ openclaw_version }}
          imagePullPolicy: Always
          command: ["sh", "-c"]
          args:
            - |
              cat << 'EOF' > /tmp/adapter.js
              const http = require('http');
              const { execFile } = require('child_process');

              const server = http.createServer((req, res) => {
                let body = '';
                req.on('data', chunk => { body += chunk; });
                req.on('end', () => {
                  try {
                    const data = JSON.parse(body);
                    console.log('Received Smee webhook:', data);

                    let msg = '';
                    if (data.event === 'github_action') {
                      const statusIcon = data.status === 'success' ? '✅' : '❌';
                      msg = `📢 *GitHub Action Build*\n• *Repositorio:* ${data.repo}\n• *Workflow:* ${data.workflow}\n• *Estado:* ${data.status} ${statusIcon}`;
                    } else {
                      msg = `📢 *Smee Webhook Recibido*\n\`\`\`json\n${JSON.stringify(data, null, 2)}\n\`\`\`;`;
                    }

                    const args = [
                      '/app/openclaw.mjs',
                      'message',
                      'send',
                      '--channel', 'telegram',
                      '--target', process.env.TELEGRAM_TARGET,
                      '--message', msg
                    ];
                    console.log('Executing execFile node with args:', args);

                    execFile('node', args, { cwd: '/app', env: { ...process.env, HOME: '/home/node' } }, (err, stdout, stderr) => {
                      if (err) {
                        console.error('Failed to send message via CLI:', err, stderr);
                        res.writeHead(500, { 'Content-Type': 'text/plain' });
                        res.end('Failed');
                      } else {
                        console.log('CLI output:', stdout);
                        res.writeHead(200, { 'Content-Type': 'text/plain' });
                        res.end('OK');
                      }
                    });
                  } catch (e) {
                    console.error('Error processing body:', e);
                    res.writeHead(400, { 'Content-Type': 'text/plain' });
                    res.end('Bad Request');
                  }
                });
              });

              server.listen(18000, '0.0.0.0', () => {
                console.log('Smee adapter listening on port 18000...');
              });
              EOF

              node /tmp/adapter.js &
              npx -y smee-client --url "{{ openclaw_smee_url }}" --target http://127.0.0.1:18000
          env:
            - name: TELEGRAM_TARGET
              value: "{{ openclaw_telegram_allowed_users.split(',')[0] }}"
            - name: OPENCLAW_GATEWAY_TOKEN
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: OPENCLAW_GATEWAY_TOKEN
            - name: OPENCLAW_CONFIG_DIR
              value: /etc/openclaw
            - name: HOME
              value: /home/node
            - name: NODE_OPTIONS
              value: "--dns-result-order=ipv4first"
            - name: OPENCLAW_WORKSPACE_DIR
              value: "/home/node/.openclaw/workspace"
            - name: HONCHO_WORKSPACE
              value: "{{ openclaw_honcho_workspace }}"
            - name: HONCHO_API_KEY
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: HONCHO_API_KEY
            - name: TELEGRAM_BOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: TELEGRAM_BOT_TOKEN
                  optional: true
            - name: TELEGRAM_ALLOWED_USERS
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: TELEGRAM_ALLOWED_USERS
                  optional: true
{% if openclaw_llm_backend == 'litellm' %}
            - name: OPENAI_API_BASE
              value: "{{ openclaw_litellm_url }}/v1"
            - name: OPENAI_API_KEY
              value: "{{ openclaw_litellm_master_key }}"
{% else %}
            - name: OPENROUTER_API_KEY
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: OPENROUTER_API_KEY
{% endif %}
          resources:
            limits:
              cpu: "2000m"
              memory: "2Gi"
            requests:
              cpu: "200m"
              memory: "512Mi"
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1000
            seccompProfile:
              type: RuntimeDefault
          volumeMounts:
            - name: openclaw-data
              mountPath: /home/node/.openclaw
            - name: openclaw-data
              mountPath: /home/node/.honcho
              subPath: .honcho-state
            - name: npm-local
              mountPath: /home/node/.openclaw/npm
            - name: openclaw-config-json
              mountPath: /etc/openclaw/openclaw.json
              subPath: openclaw.json

{% if openclaw_mcp_bridge_enabled | default(false) %}
        # ── OpenClaw MCP Bridge ───────────────────────────────────────────────
        # Stateful Node.js bridge (no supergateway) on port {{ openclaw_mcp_bridge_port }}.
        # Spawns `openclaw mcp serve` ONCE, initializes it, then routes all HTTP
        # POST /mcp requests directly via stdio — no per-request auto-init overhead.
        # GET /mcp returns an empty SSE keepalive so Python MCP SDK doesn't get 405.
        # Child crash → bridge auto-restarts it (3s delay).
        - name: openclaw-mcp-bridge
          image: {{ openclaw_image }}:{{ openclaw_version }}
          imagePullPolicy: Always
          command: ["sh", "-c"]
          args:
            - |
              cat > /tmp/bridge.js << 'BRIDGEOF'
              const http = require('http');
              const { spawn } = require('child_process');
              const readline = require('readline');
              const PORT = parseInt(process.env.BRIDGE_PORT || '18790');
              const GW_URL = process.env.GW_URL;
              const GW_TOKEN = process.env.GW_TOKEN;
              let child = null, rl_iface = null;
              const pending = new Map();
              let nid = 1, initialized = false, queue = [];
              let childInitResult = null;
              function startChild() {
                child = spawn('node', ['dist/index.js', 'mcp', 'serve', '--url', GW_URL, '--token', GW_TOKEN]);
                child.stderr.on('data', d => process.stderr.write('[mcp-serve] ' + d));
                child.on('exit', code => {
                  console.log('[bridge] mcp serve exited code=' + code + ', restarting in 3s');
                  initialized = false;
                  for (const [id, cb] of pending) cb({ jsonrpc: '2.0', id, error: { code: -32000, message: 'mcp serve restarted' } });
                  pending.clear();
                  setTimeout(startChild, 3000);
                });
                rl_iface = readline.createInterface({ input: child.stdout, crlfDelay: Infinity });
                rl_iface.on('line', line => {
                  if (!line.trim()) return;
                  try {
                    const m = JSON.parse(line);
                    if (m.id !== undefined && pending.has(String(m.id))) {
                      const cb = pending.get(String(m.id)); pending.delete(String(m.id)); cb(m);
                    }
                  } catch(e) {}
                });
                const initId = nid++;
                pending.set(String(initId), r => {
                  childInitResult = r.result;
                  child.stdin.write(JSON.stringify({ jsonrpc: '2.0', method: 'notifications/initialized', params: {} }) + '\n');
                  initialized = true;
                  console.log('[bridge] mcp serve ready, proto:', childInitResult && childInitResult.protocolVersion);
                  const q = queue.splice(0); q.forEach(f => f());
                });
                child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id: initId, method: 'initialize',
                  params: { protocolVersion: '2024-11-05', capabilities: {}, clientInfo: { name: 'bridge', version: '1.0' } } }) + '\n');
              }
              startChild();
              function callTool(name, args, cb) {
                const id = nid++;
                pending.set(String(id), cb);
                child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method: 'tools/call', params: { name, arguments: args } }) + '\n');
              }
              function getEvents(r) {
                if (r.result && r.result.structuredContent && r.result.structuredContent.events) return r.result.structuredContent.events;
                try {
                  const txt = r.result && r.result.content && r.result.content[0] && r.result.content[0].text || '';
                  const json = JSON.parse(txt.replace(/^events:\s*\d+\s*/,''));
                  return json.events || json || [];
                } catch(e) { return []; }
              }
              function waitForReply(sk, afterCursor, sentAt, sse, msgId, attempt) {
                callTool('events_wait', { session_key: sk, after_cursor: afterCursor, timeout_ms: 60000 }, r => {
                  let reply = null, lastCursor = afterCursor;
                  const evs = getEvents(r);
                  for (const ev of evs) {
                    if (ev.cursor > lastCursor) lastCursor = ev.cursor;
                    if (ev.role === 'assistant' && ev.text && (ev.updatedAt || 0) >= sentAt) reply = ev.text;
                  }
                  if (reply) return sse({ jsonrpc: '2.0', id: msgId, result: { content: [{ type: 'text', text: reply }] } });
                  if (attempt < 2) return waitForReply(sk, lastCursor, sentAt, sse, msgId, attempt + 1);
                  sse({ jsonrpc: '2.0', id: msgId, result: { content: [{ type: 'text', text: 'Timeout: OpenClaw did not respond in time' }] } });
                });
              }
              function askOpenclaw(question, sse, msgId) {
                const sk = 'agent:main:main';
                const sentAt = Date.now();
                callTool('events_poll', { session_key: sk, limit: 1 }, r2 => {
                  let cursor = 0;
                  try { const evs = getEvents(r2); if (evs.length) cursor = evs[evs.length-1].cursor; } catch(e) {}
                  callTool('messages_send', { session_key: sk, text: question }, r3 => {
                    if (r3.error) return sse({ jsonrpc: '2.0', id: msgId, result: { content: [{ type: 'text', text: 'Error sending: ' + JSON.stringify(r3.error) }] } });
                    waitForReply(sk, cursor, sentAt, sse, msgId, 0);
                  });
                });
              }
              const ASK_OPENCLAW_TOOL = { name: 'ask_openclaw_agent', description: 'Pregunta al agente OpenClaw (Tito) sobre el cluster. Envía una pregunta a su loop de razonamiento autónomo y espera su respuesta.', inputSchema: { type: 'object', properties: { question: { type: 'string' } }, required: ['question'] } };
              http.createServer((req, res) => {
                if (req.method === 'GET') {
                  res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', 'Connection': 'keep-alive' });
                  res.write(': ok\n\n');
                  const k = setInterval(() => { try { res.write(': k\n\n'); } catch(e) { clearInterval(k); } }, 15000);
                  req.on('close', () => clearInterval(k));
                  return;
                }
                let body = '';
                req.on('data', d => body += d);
                req.on('end', () => {
                  let msg; try { msg = JSON.parse(body); } catch(e) { res.writeHead(400); res.end(); return; }
                  const sse = data => {
                    res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache' });
                    res.end('event: message\ndata: ' + JSON.stringify(data) + '\n\n');
                  };
                  if (msg.method === 'initialize') {
                    sse({ jsonrpc: '2.0', id: msg.id, result: childInitResult || { protocolVersion: '2024-11-05', capabilities: { tools: { listChanged: true } }, serverInfo: { name: 'openclaw', version: 'unknown' } } });
                    return;
                  }
                  if (msg.method && msg.method.startsWith('notifications/')) { res.writeHead(202); res.end(); return; }
                  if (msg.method === 'tools/list') {
                    const doList = () => {
                      const id = nid++;
                      pending.set(String(id), r => {
                        r.id = msg.id;
                        if (r.result && r.result.tools) r.result.tools.push(ASK_OPENCLAW_TOOL);
                        sse(r);
                      });
                      child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method: 'tools/list', params: {} }) + '\n');
                    };
                    if (initialized) doList(); else queue.push(doList);
                    return;
                  }
                  if (msg.method === 'tools/call' && msg.params && msg.params.name === 'ask_openclaw_agent') {
                    const q = (msg.params.arguments && msg.params.arguments.question) || '';
                    const doAsk = () => askOpenclaw(q, sse, msg.id);
                    if (initialized) doAsk(); else queue.push(doAsk);
                    return;
                  }
                  const fwd = () => {
                    const id = nid++;
                    pending.set(String(id), r => { r.id = msg.id; sse(r); });
                    child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method: msg.method, params: msg.params }) + '\n');
                  };
                  if (initialized) fwd(); else queue.push(fwd);
                });
              }).listen(PORT, () => console.log('[bridge] :' + PORT + ' ready'));
              BRIDGEOF
              GW_URL="ws://localhost:{{ openclaw_gateway_port }}" \
              GW_TOKEN="$OPENCLAW_GATEWAY_TOKEN" \
              BRIDGE_PORT="{{ openclaw_mcp_bridge_port }}" \
              node /tmp/bridge.js
          env:
            - name: HOME
              value: /home/node
            - name: NODE_OPTIONS
              value: "--dns-result-order=ipv4first"
            - name: OPENCLAW_GATEWAY_TOKEN
              valueFrom:
                secretKeyRef:
                  name: openclaw-secrets
                  key: OPENCLAW_GATEWAY_TOKEN
            - name: OPENCLAW_CONFIG_DIR
              value: /etc/openclaw
            - name: OPENCLAW_WORKSPACE_DIR
              value: /home/node/.openclaw/workspace
          ports:
            - name: mcp-bridge
              containerPort: {{ openclaw_mcp_bridge_port }}
              protocol: TCP
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1000
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: openclaw-data
              mountPath: /home/node/.openclaw
            - name: openclaw-data
              mountPath: /home/node/.honcho
              subPath: .honcho-state
            - name: npm-local
              mountPath: /home/node/.openclaw/npm
            - name: openclaw-config-json
              mountPath: /etc/openclaw/openclaw.json
              subPath: openclaw.json
            - name: tmp
              mountPath: /tmp
{% endif %}
      volumes:
        - name: openclaw-data
          persistentVolumeClaim:
            claimName: openclaw-data
        - name: npm-local
          emptyDir: {}
        # openclaw-secure-agent (emptyDir) eliminado 2026-06-09: agents/main ahora
        # vive en el PVC openclaw-data → sesiones del agente persisten entre restarts.
        - name: openclaw-config-json
          configMap:
            name: openclaw-config
            items:
              - key: openclaw.json
                path: openclaw.json
        - name: openclaw-agents-md
          configMap:
            name: openclaw-config
            items:
              - key: AGENTS.md
                path: AGENTS.md
        - name: tmp
          emptyDir:
            sizeLimit: 256Mi
