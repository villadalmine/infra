# Service — ClusterIP (never LoadBalancer per project rules)
apiVersion: v1
kind: Service
metadata:
  name: openclaw
  namespace: {{ openclaw_namespace }}
spec:
  type: ClusterIP
  selector:
    app: openclaw
  ports:
    - name: gateway
      port: {{ openclaw_gateway_port }}
      targetPort: gateway
      protocol: TCP
{% if openclaw_mcp_bridge_enabled | default(false) %}
    - name: mcp-bridge
      port: {{ openclaw_mcp_bridge_port }}
      targetPort: mcp-bridge
      protocol: TCP
{% endif %}
---
# HTTPRoute — Cilium Gateway at 192.168.178.200
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: openclaw
  namespace: {{ openclaw_namespace }}
spec:
  parentRefs:
    - name: cluster-gateway
      namespace: gateway
  hostnames:
    - {{ openclaw_hostname }}
  rules:
    - backendRefs:
        - name: openclaw
          port: {{ openclaw_gateway_port }}
---
# NetworkPolicy — restrict egress to known endpoints only
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: openclaw-egress
  namespace: {{ openclaw_namespace }}
spec:
  podSelector:
    matchLabels:
      app: openclaw
  policyTypes:
    - Egress
    - Ingress
  ingress:
    # Webhooks (AlertManager, ArgoCD, external via Gateway) + Smee.io Client (openclaw)
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kaniko
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: gateway
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: argocd
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openclaw
      ports:
        - port: {{ openclaw_gateway_port }}
          protocol: TCP
{% if openclaw_mcp_bridge_enabled | default(false) %}
    # A2A reverse — Hermes calls OpenClaw MCP bridge (streamable-http)
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ai
          podSelector:
            matchLabels:
              app: hermes-agent-mcp
      ports:
        - port: {{ openclaw_mcp_bridge_port }}
          protocol: TCP
{% endif %}
  egress:
    # DNS
    - ports:
        - port: 53
          protocol: UDP
        - port: 53
          protocol: TCP
    # OpenClaw Gateway (internal communication / CLI)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ openclaw_namespace }}
      ports:
        - port: {{ openclaw_gateway_port }}
          protocol: TCP
    # LiteLLM proxy (in-cluster — all LLM traffic)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ai
          podSelector:
            matchLabels:
              app: litellm-proxy
      ports:
        - port: 4000
          protocol: TCP
    # External HTTPS (Telegram API, OpenRouter if direct, etc.)
    - ports:
        - port: 443
          protocol: TCP
    # K8s API server (for kubernetes-mcp sidecar)
    - ports:
        - port: 6443
          protocol: TCP
    # Kagent — kagent-tools MCP server (port 8084, targetPort 8084)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kagent
      ports:
        - port: 8084
          protocol: TCP
    # Hermes — MCP subagent (port 8000 = hermes gateway MCP HTTP server)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ai
          podSelector:
            matchLabels:
              app: hermes-agent-mcp
      ports:
        - port: 8000
          protocol: TCP
    # Honcho — self-hosted memory platform (svc port 80 → pod targetPort 8000)
    # NetworkPolicy is evaluated post-DNAT so must use the pod port (8000), not the service port (80)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: honcho
      ports:
        - port: 8000
          protocol: TCP
    # Prometheus — queries de métricas read-only
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - port: 9090
          protocol: TCP
    # Red home — análisis de dispositivos read-only (Hue, cámaras, NAS)
    - to:
        - ipBlock:
            cidr: 192.168.178.0/24
      ports:
        - port: 80
          protocol: TCP
        - port: 443
          protocol: TCP
        - port: 8080
          protocol: TCP
        - port: 554
          protocol: TCP
---
# Ingress rule on the kagent side: allow kagent-controller + openclaw to reach kagent-tools MCP
# NOTE: adding ANY NetworkPolicy to a pod enables ingress enforcement — must explicitly allow
# all legitimate sources or kagent-controller will be blocked (i/o timeout on /mcp).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-openclaw-to-kagent-tools
  namespace: kagent
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: kagent-tools
  policyTypes:
    - Ingress
  ingress:
    # kagent-controller and internal kagent services (same namespace)
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kagent
      ports:
        - port: 8084
          protocol: TCP
    # openclaw gateway
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openclaw
      ports:
        - port: 8084
          protocol: TCP
