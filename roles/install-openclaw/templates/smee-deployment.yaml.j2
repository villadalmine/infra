apiVersion: apps/v1
kind: Deployment
metadata:
  name: smee-client
  namespace: {{ openclaw_namespace }}
  labels:
    app: smee-client
spec:
  replicas: 1
  selector:
    matchLabels:
      app: smee-client
  template:
    metadata:
      labels:
        app: smee-client
    spec:
      containers:
        - name: smee-client
          image: node:20-alpine
          command: ["npx", "smee-client"]
          args:
            - "--url"
            - "{{ openclaw_smee_url }}"
            - "--target"
            - "http://openclaw:18789/hooks/wake"
          resources:
            requests:
              cpu: "10m"
              memory: "32Mi"
            limits:
              cpu: "100m"
              memory: "64Mi"
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1000
            seccompProfile:
              type: RuntimeDefault
      tolerations:
        - operator: Exists
