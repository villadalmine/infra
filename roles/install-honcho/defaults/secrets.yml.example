# Copy this file to secrets.yml and fill in your real values.
# secrets.yml is gitignored — NEVER commit passwords to the repo.
#
#   cp roles/install-honcho/defaults/secrets.yml.example \
#      roles/install-honcho/defaults/secrets.yml
#   vim roles/install-honcho/defaults/secrets.yml

# ─── PostgreSQL password ──────────────────────────────────────────────────────
# Password for the honcho postgres user.
# Generate: openssl rand -hex 16
honcho_db_password: "CHANGE_ME_openssl_rand_-hex_16"
