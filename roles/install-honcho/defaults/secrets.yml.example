# Copy this file to secrets.yml and fill in values.
# Generate honcho_jwt_secret: python3 -c "import secrets; print(secrets.token_hex(32))"
# Generate workspace JWTs after you have the secret:
#   python3 -c "import jwt; print(jwt.encode({'t':'','w':'openclaw'}, SECRET, 'HS256'))"
#   python3 -c "import jwt; print(jwt.encode({'t':'','ad':True}, SECRET, 'HS256'))"

honcho_db_password: "your-secure-password-here"
honcho_jwt_secret: "your-64-char-hex-here"
honcho_admin_key: "your-admin-jwt-here"
