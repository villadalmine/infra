apiVersion: v1
kind: Service
metadata:
  name: hermes-agent-mcp
  namespace: {{ hermes_namespace }}
spec:
  type: ClusterIP
  selector:
    app: hermes-agent-mcp
  ports:
    - name: mcp
      port: 8000
      targetPort: 8000
      protocol: TCP
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: hermes-agent-mcp
  namespace: {{ hermes_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: hermes-agent-mcp-readonly
rules:
  - apiGroups: [""]
    resources:
      - pods
      - pods/log
      - pods/exec
      - namespaces
      - services
      - endpoints
      - configmaps
      - nodes
      - events
      - persistentvolumeclaims
      - persistentvolumes
      - resourcequotas
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets", "statefulsets", "daemonsets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["batch"]
    resources: ["jobs", "cronjobs"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["gateway.networking.k8s.io"]
    resources: ["httproutes", "gateways", "grpcroutes", "tcproutes", "tlsroutes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["networkpolicies"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["cilium.io"]
    resources:
      - ciliumloadbalancerippools
      - ciliuml2announcementpolicies
      - ciliumnetworkpolicies
      - ciliumclusterwidenetworkpolicies
      - ciliumendpoints
      - ciliumidentities
    verbs: ["get", "list", "watch"]
  - apiGroups: ["kagent.dev"]
    resources: ["agents", "modelconfigs", "mcpservers", "remotemcpservers"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: hermes-agent-mcp-readonly
subjects:
  - kind: ServiceAccount
    name: hermes-agent-mcp
    namespace: {{ hermes_namespace }}
roleRef:
  kind: ClusterRole
  name: hermes-agent-mcp-readonly
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hermes-agent-mcp
  namespace: {{ hermes_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: hermes-agent-mcp
  template:
    metadata:
      labels:
        app: hermes-agent-mcp
    spec:
      serviceAccountName: hermes-agent-mcp
      nodeSelector:
        kubernetes.io/hostname: {{ hermes_node_hostname }}
      tolerations:
        - operator: Exists
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        fsGroup: 1000
      initContainers:
        - name: create-env-file
          image: busybox:1.36
          command: ["sh", "-c"]
          args:
            - |
              cat <<EOF > /opt/data/.env
              OPENAI_API_KEY={{ hermes_openai_api_key }}
              OPENAI_API_BASE={{ hermes_openai_api_base }}
              EOF
              chmod 644 /opt/data/.env

              # Initialize and symlink gateway.json to PVC for persistence
              mkdir -p /opt/data/.hermes
              if [ ! -f /opt/data/.hermes/gateway.json ]; then
                cp /etc/hermes/gateway.json /opt/data/.hermes/gateway.json
                chown -R 1000:1000 /opt/data/.hermes/gateway.json || true
              fi
              ln -sf /opt/data/.hermes/gateway.json /opt/data/gateway.json
          volumeMounts:
            - name: hermes-data
              mountPath: /opt/data
            - name: hermes-home
              mountPath: /opt/data/.hermes
            - name: hermes-gateway-config
              mountPath: /etc/hermes
      containers:
        - name: hermes-agent
          image: {{ hermes_registry }}/{{ hermes_image_name }}:{{ hermes_image_tag }}
          imagePullPolicy: IfNotPresent
          workingDir: /opt/data
          command: ["python3", "-c"]
          args:
            - |
              import sys
              import asyncio
              sys.path.append('/opt/hermes')
              from mcp_serve import create_mcp_server, EventBridge

              bridge = EventBridge()
              bridge.start()
              server = create_mcp_server(event_bridge=bridge)
              server.settings.host = '0.0.0.0'
              server.settings.port = 8000
              server.settings.transport_security.enable_dns_rebinding_protection = False

              @server.tool(name="ask_hermes_agent", description="Pregunta conversacional de cerebro a cerebro a Hermes Agent. Permite hablar directamente con el bucle de razonamiento autónomo de Hermes y sus herramientas locales (kagent, kubernetes read-only, etc.).")
              def ask_hermes_agent(question: str) -> str:
                  """Pregunta conversacional a Hermes Agent.

                  Args:
                      question: Consulta o instrucción detallada para Hermes.
                  """
                  import os
                  from run_agent import AIAgent

                  agent = AIAgent(
                      model=os.environ.get("HERMES_MODEL", "hermes-qwen"),
                      base_url=os.environ.get("OPENAI_API_BASE"),
                      api_key=os.environ.get("OPENAI_API_KEY"),
                      max_iterations=90,
                      quiet_mode=True,
                      verbose_logging=False
                  )
                  try:
                      res = agent.run_conversation(user_message=question)
                      response = res.get("final_response", "") if res else ""
                      if not response and res and res.get("error"):
                          response = f"Error: {res['error']}"
                      return response
                  except Exception as e:
                      return f"Error executing Hermes conversation: {e}"

              async def run_gateway():
                  try:
                      from gateway.run import start_gateway
                      await start_gateway()
                  except Exception as e:
                      import logging
                      logging.getLogger("hermes.gateway").error("Gateway failed: %s", e)

              async def main():
                  try:
                      await asyncio.gather(
                          server.run_streamable_http_async(),
                          run_gateway()
                      )
                  finally:
                      bridge.stop()

              asyncio.run(main())
          ports:
            - name: mcp
              containerPort: 8000
              protocol: TCP
          env:
            - name: HOME
              value: /opt/data
            - name: HERMES_MODEL
              value: {{ hermes_model }}
            - name: HERMES_TEMPERATURE
              value: "{{ hermes_temperature }}"
            - name: OPENAI_API_BASE
              value: {{ hermes_openai_api_base }}
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: hermes-secrets
                  key: OPENAI_API_KEY
            - name: HERMES_HOME
              value: /opt/data
            - name: TELEGRAM_BOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hermes-secrets
                  key: TELEGRAM_BOT_TOKEN
            - name: HERMES_SYSTEM_PROMPT
              value: |
                {{ hermes_system_prompt | indent(16) }}
            - name: GATEWAY_ALLOW_ALL_USERS
              value: "true"
            - name: TELEGRAM_ALLOWED_USERS
              value: "{{ hermes_telegram_allowed_users }}"
            - name: GROQ_API_KEY
              valueFrom:
                secretKeyRef:
                  name: hermes-secrets
                  key: GROQ_API_KEY
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://alloy.observability.svc.cluster.local:4318"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: hermes-data
              mountPath: /opt/data
            - name: hermes-home
              mountPath: /opt/data/.hermes
            - name: tmp
              mountPath: /tmp
            - name: hermes-config
              mountPath: /opt/data/config.yaml
              subPath: config.yaml
        - name: kubernetes-mcp-server
          image: {{ hermes_registry }}/{{ hermes_mcp_image_name }}:{{ hermes_mcp_image_tag }}
          imagePullPolicy: IfNotPresent
          command: ["sh", "-c"]
          args:
            - |
              # Generate kubeconfig for sidecar
              mkdir -p ~/.kube
              CA=$(cat /var/run/secrets/kubernetes.io/serviceaccount/ca.crt | base64 | tr -d '\n')
              TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
              cat <<EOF > ~/.kube/config
              apiVersion: v1
              kind: Config
              clusters:
              - cluster:
                  certificate-authority-data: ${CA}
                  server: https://kubernetes.default.svc
                name: cluster
              contexts:
              - context:
                  cluster: cluster
                  user: default
                name: default
              current-context: default
              users:
              - name: default
                user:
                  token: ${TOKEN}
              EOF
              exec /usr/local/bin/kubernetes-mcp-server --port 8080
          ports:
            - name: sse
              containerPort: 8080
              protocol: TCP
          env:
            - name: HOME
              value: /tmp
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: hermes-data
          emptyDir: {}
        - name: hermes-home
          persistentVolumeClaim:
            claimName: hermes-home-pvc
        - name: tmp
          emptyDir:
            sizeLimit: 128Mi
        - name: hermes-gateway-config
          configMap:
            name: hermes-gateway-config
        - name: hermes-config
          configMap:
            name: hermes-config
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: hermes-agent-metrics
  namespace: {{ hermes_namespace }}
spec:
  selector:
    matchLabels:
      app: hermes-agent-mcp
  endpoints:
    - port: mcp
      path: /metrics
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: hermes-home-pvc
  namespace: {{ hermes_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ hermes_storage_class }}
  resources:
    requests:
      storage: {{ hermes_storage_size }}
