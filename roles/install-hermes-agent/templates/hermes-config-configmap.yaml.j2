apiVersion: v1
kind: ConfigMap
metadata:
  name: hermes-config
  namespace: {{ hermes_namespace }}
data:
  config.yaml: |
    model:
      provider: custom
      default: {{ hermes_model }}
      base_url: {{ hermes_openai_api_base }}
      api_key_env: OPENAI_API_KEY

    agent:
      tool_use_enforcement: true
      system_prompt: |
{{ hermes_system_prompt | indent(8, first=True) }}

    auxiliary:
      provider: custom
      model: {{ hermes_model }}
      base_url: {{ hermes_openai_api_base }}
      api_key_env: OPENAI_API_KEY

    memory:
      provider: {{ hermes_memory_provider }}
      memory_enabled: {{ hermes_memory_enabled | lower }}
      user_profile_enabled: {{ hermes_user_profile_enabled | lower }}
      memory_char_limit: 2200
      user_char_limit: 1375

{% if hermes_groq_api_key | default('') != '' %}
    stt:
      provider: groq
      model: whisper-large-v3-turbo

{% endif %}
    mcp_servers:
      kubernetes:
        url: {{ hermes_mcp_url }}
        timeout: {{ hermes_mcp_timeout }}
        connect_timeout: {{ hermes_mcp_connect_timeout }}
      kagent:
        url: {{ hermes_kagent_mcp_url }}
        timeout: {{ hermes_kagent_mcp_timeout }}
        connect_timeout: {{ hermes_kagent_mcp_connect_timeout }}
      openclaw:
        url: {{ hermes_openclaw_mcp_url }}
        timeout: {{ hermes_openclaw_mcp_timeout }}
        connect_timeout: {{ hermes_openclaw_mcp_connect_timeout }}

