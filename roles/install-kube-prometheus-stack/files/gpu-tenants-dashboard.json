{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["gpu", "hami", "tenants"],
  "title": "GPU per-tenant (HAMi)",
  "uid": "hami-gpu-tenants",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "VRAM reserved per tenant (MiB)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hami_resource_quota_used{quota_name=\"nvidia.com/gpumem\"}", "legendFormat": "{{exported_namespace}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU cores reserved per tenant (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hami_resource_quota_used{quota_name=\"nvidia.com/gpucores\"}", "legendFormat": "{{exported_namespace}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "VRAM allocated per physical GPU (GB)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "decgbytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (device_type, device_uuid) (hami_gpu_memory_allocated_bytes) / 1e9", "legendFormat": "{{device_type}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Compute allocated per physical GPU (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (device_type, device_uuid) (hami_gpu_core_allocated_ratio)", "legendFormat": "{{device_type}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "vGPU shared containers per GPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hami_gpu_shared_count", "legendFormat": "{{device_type}}", "refId": "A" }
      ]
    }
  ]
}
